# ============================================================
#  Trade API — Variables d'environnement
#  Copier ce fichier en .env et remplir toutes les valeurs.
#  NE JAMAIS committer le fichier .env.
# ============================================================

# ── Serveur ──────────────────────────────────────────────────
# "production" active les controles de configuration au demarrage
ENV=production
PORT=8000
# Documentation interactive /docs (fermee par defaut en production)
ENABLE_DOCS=false

# ── Logs ─────────────────────────────────────────────────────
LOG_DIR=/app/logs
LOG_LEVEL=INFO

# ── Base de donnees PostgreSQL ────────────────────────────────
# docker-compose construit l'adresse a partir de ces valeurs. Hors Docker,
# DATABASE_URL=postgresql://utilisateur:mot_de_passe@hote/base les remplace.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tradeapp
DB_USER=tradeuser
DB_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_FORT

# ── JWT ──────────────────────────────────────────────────────
# Generer : python -c "import secrets; print(secrets.token_hex(64))"
# Les deux secrets doivent etre differents.
JWT_SECRET=CHANGE_MOI_SECRET_JWT_64_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_MOI_REFRESH_SECRET_DIFFERENT
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
MAX_REFRESH_TOKENS=5

# ── CORS et redirections ─────────────────────────────────────
# Version web de l'app — JAMAIS * en production.
# Plusieurs origines : CORS_ORIGINS=https://app.exemple.com,https://admin.exemple.com
CORS_ORIGINS=https://YOUR_WEB_DOMAIN
# Adresse publique de l'API (retour et notification PayDunya)
PUBLIC_API_URL=https://YOUR_DOMAIN
# Ou l'API peut renvoyer l'utilisateur apres paiement
APP_REDIRECT_PREFIXES=finadvisor://,https://YOUR_WEB_DOMAIN

# ── Limites de debit (requetes / 15 min) ─────────────────────
RATE_LIMIT_GLOBAL=1000
RATE_LIMIT_USER=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_MUTATION=20
RATE_LIMIT_ADMIN=200
RATE_LIMIT_PAYMENT_RETURN=30

# ── Assistant (API Claude) ───────────────────────────────────
# Sans cle, l'assistant repond "indisponible" ; le reste fonctionne.
ANTHROPIC_API_KEY=
ASSISTANT_LIMIT_FREE=3
ASSISTANT_LIMIT_PRO=50

# ── PayDunya ─────────────────────────────────────────────────
# Tableau de bord > Integrez notre API > ton application.
# "test" = bac a sable (cles de test), "live" = vrais paiements.
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME=Financial AI Advisor
PRO_PRICE_XOF=5000
PRO_DAYS=30

# ── Administration ───────────────────────────────────────────
# Import de cours, reentrainement : en-tete X-Admin-Key. Vide = desactive.
ADMIN_API_KEY=

# ── Flux de cours quotidien (prestataire autorise, CSV ou JSON) ─
QUOTES_FEED_URL=
# En-tete d'authentification eventuel, "Nom: valeur"
QUOTES_FEED_HEADER=
